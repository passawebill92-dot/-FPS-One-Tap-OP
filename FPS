local speedApplied, jumpApplied = false, false

local function updatePlayer()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if Toggles.Speed.Value then
        hum.WalkSpeed = Options.SpeedValue.Value
        speedApplied = true
    elseif speedApplied then
        hum.WalkSpeed = DEFAULT_WALKSPEED
        speedApplied = false
    end

    if Toggles.Jump.Value then
        hum.UseJumpPower = true
        hum.JumpPower = Options.JumpValue.Value
        jumpApplied = true
    elseif jumpApplied then
        hum.JumpPower = DEFAULT_JUMPPOWER
        jumpApplied = false
    end
end

bind(UIS.JumpRequest, function()
    if not (Running and Toggles.InfJump.Value) then return end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

bind(RunService.Stepped, function()
    if not Running then return end
    if not (Toggles.Noclip.Value or Toggles.CoinFarm.Value) then return end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end)

bind(LP.Idled, function()
    if Running and Toggles.AntiAFK.Value then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.zero)
    end
end)

