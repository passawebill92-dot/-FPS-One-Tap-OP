local function findTool(holder, tag)
    if not holder then return nil end
    for _, t in ipairs(holder:GetChildren()) do
        if t:IsA("Tool") and CollectionService:HasTag(t, tag) then return t end
    end
    return nil
end

-- own tools: character + backpack. other players: only the equipped tool replicates.
local function ownTool(tag)
    return findTool(LP.Character, tag) or findTool(LP:FindFirstChildOfClass("Backpack"), tag)
end

local function getRole(plr)
    local d = PlayerData[plr.Name]
    local role = d and not d.Dead and d.Role or nil
    -- picked-up gun shows on the character before the data table catches up
    if role == "Innocent" and findTool(plr.Character, "Weapon_Gun") then role = "Hero" end
    if plr == LP then
        if ownTool("Weapon_Knife") then role = "Murderer" end
        if role ~= "Murderer" and ownTool("Weapon_Gun") and role ~= "Sheriff" then role = "Hero" end
    end
    return role
end

local function findByRole(role)
    for _, plr in ipairs(Players:GetPlayers()) do
        if getRole(plr) == role then return plr end
    end
    return nil
end

local function rootOf(plr)
    local char = plr and plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local lastAnnounced = nil
local function onDataUpdated()
    local murderer = findByRole("Murderer")
    local sheriff = findByRole("Sheriff") or findByRole("Hero")
    roleLabel:SetText(("murderer: %s\nsheriff: %s"):format(
        murderer and murderer.DisplayName or "?", sheriff and sheriff.DisplayName or "?"))

    if Toggles.RoleNotify.Value and murderer and murderer.Name ~= lastAnnounced then
        lastAnnounced = murderer.Name
        Library:Notify({
            Title = "Roles",
            Description = ("Murderer: %s\nSheriff: %s"):format(murderer.DisplayName, sheriff and sheriff.DisplayName or "?"),
            Time = 6,
        })
    end
end

local function setPlayerData(d)
    if type(d) == "table" then PlayerData = d end
    onDataUpdated()
end

bind(Gameplay:WaitForChild("PlayerDataChanged").OnClientEvent, setPlayerData)
bind(Gameplay:WaitForChild("RoundStart").OnClientEvent, function(_, data)
    lastAnnounced = nil
    setPlayerData(data)
end)
