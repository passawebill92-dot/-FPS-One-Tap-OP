-- ═══════════════════════════════════════════
local NIL = {}
local Originals = {} -- [table] = { [key] = original or NIL }

local function setField(t, k, v)
    Originals[t] = Originals[t] or {}
    if Originals[t][k] == nil then
        local cur = rawget(t, k)
        Originals[t][k] = cur == nil and NIL or cur
    end
    rawset(t, k, v)
end

local function restoreField(t, k)
    local saved = Originals[t] and Originals[t][k]
    if saved == nil then return end
    if saved == NIL then rawset(t, k, nil) else rawset(t, k, saved) end
    Originals[t][k] = nil
end

local function restoreAllFields()
    for t, fields in pairs(Originals) do
        for k in pairs(fields) do restoreField(t, k) end
    end
end

local function applyWeaponMods()
    local WM = Hook.WeaponManager
    if not WM then return end

    local weapons = WM.getWeapons()
    local function perWeapon(enabled, key, value)
        for _, data in pairs(weapons) do
            if enabled then setField(data, key, value) else restoreField(data, key) end
        end
    end

    perWeapon(Toggles.FastReload.Value, "reloadTime", Options.ReloadTime.Value)

    local C = WM.Constants
    if Toggles.FastBullets.Value then setField(C, "DEFAULT_SPEED", 50000) else restoreField(C, "DEFAULT_SPEED") end
    if Toggles.LongRange.Value then setField(C, "DEFAULT_MAX_DISTANCE", 5000) else restoreField(C, "DEFAULT_MAX_DISTANCE") end
end

