bind(Gameplay:WaitForChild("CoinsStarted").OnClientEvent, function() table.clear(BagFull) end)

local skipped = {}   -- coins we reached that never registered
local farmTarget, farmArrived = nil, nil

local function nextCoin(myRoot)
    local murderer = Toggles.AvoidMurderer.Value and rootOf(findByRole("Murderer"))
    local best, bestD
    for _, map in ipairs(workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            for _, coin in ipairs(container:GetChildren()) do
                if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not coin:GetAttribute("Collected")
                    and not skipped[coin] and not BagFull[coin:GetAttribute("CoinID")]
                    and not (murderer and (coin.Position - murderer.Position).Magnitude < Options.AvoidRadius.Value) then
                    local d = (coin.Position - myRoot.Position).Magnitude
                    if not bestD or d < bestD then best, bestD = coin, d end
                end
            end
        end
    end
    return best
end

local function updateCoinFarm(dt)
    if not Toggles.CoinFarm.Value then
        farmTarget = nil
        return
    end
    local myData = PlayerData[LP.Name]
    local myRoot = rootOf(LP)
    if not (myRoot and myData and not myData.Dead) then
        farmTarget = nil
        return
    end

    if not farmTarget or not farmTarget.Parent or farmTarget:GetAttribute("Collected") then
        farmTarget = nextCoin(myRoot)
        farmArrived = nil
        if not farmTarget then return end
    end

    local goal = farmTarget.Position
    local delta = goal - myRoot.Position
    local step = Options.FarmSpeed.Value * dt
    myRoot.AssemblyLinearVelocity = Vector3.zero
    if delta.Magnitude <= step then
        myRoot.CFrame = CFrame.new(goal)
        farmArrived = farmArrived or os.clock()
        -- sat on it a full second and the server never marked it: skip it
        if os.clock() - farmArrived > 1 then
            skipped[farmTarget] = true
            farmTarget = nil
        end
    else
        myRoot.CFrame = CFrame.new(myRoot.Position + delta.Unit * step)
    end
end

bind(Gameplay:WaitForChild("CoinsStarted").OnClientEvent, function() table.clear(skipped) end)

