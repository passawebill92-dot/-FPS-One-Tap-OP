-- ESP
-- ═══════════════════════════════════════════
local espFolder = Instance.new("Folder")
espFolder.Name = HttpService:GenerateGUID(false)
espFolder.Parent = gethui and gethui() or svc("CoreGui")

local ESP = {} -- [player] = { hl, name, tracer }

local function roleColor(role)
    if role == "Murderer" then return Options.ColMurderer.Value end
    if role == "Sheriff" then return Options.ColSheriff.Value end
    if role == "Hero" then return Options.ColHero.Value end
    return Options.ColInnocent.Value
end

local function getESP(plr)
    local o = ESP[plr]
    if o then return o end
    o = {
        hl = Instance.new("Highlight"),
        name = Drawing.new("Text"),
        tracer = Drawing.new("Line"),
    }
    o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    o.hl.FillTransparency = 0.55
    o.hl.OutlineTransparency = 0
    o.hl.Enabled = false
    o.hl.Parent = espFolder
    o.name.Size = 14
    o.name.Center = true
    o.name.Outline = true
    o.name.Font = 2
    o.name.Visible = false
    o.tracer.Thickness = 1
    o.tracer.Visible = false
    ESP[plr] = o
    return o
end

local function removeESP(plr)
    local o = ESP[plr]
    if not o then return end
    o.hl:Destroy()
    o.name:Remove()
    o.tracer:Remove()
    ESP[plr] = nil
end

local gunHL = Instance.new("Highlight")
gunHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
gunHL.FillTransparency = 0.3
gunHL.Enabled = false
gunHL.Parent = espFolder
local gunText = Drawing.new("Text")
gunText.Size = 14
gunText.Center = true
gunText.Outline = true
gunText.Font = 2
gunText.Text = "DROPPED GUN"
gunText.Visible = false

local function updateESP()
    local cam = workspace.CurrentCamera
    local vp = cam.ViewportSize
    local myRoot = rootOf(LP)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local o = getESP(plr)
            local root = rootOf(plr)
            local role = root and getRole(plr)
            local show = Toggles.ESPEnabled.Value and root ~= nil and role ~= nil
                and (role ~= "Innocent" or Toggles.ESPInnocents.Value)

            if not show then
                o.hl.Enabled = false
                o.name.Visible = false
                o.tracer.Visible = false
            else
                local col = roleColor(role)

                o.hl.Adornee = plr.Character
                o.hl.FillColor = col
                o.hl.OutlineColor = col
                o.hl.Enabled = Toggles.ESPChams.Value

                local head = plr.Character:FindFirstChild("Head") or root
                local sp, onScreen = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 2, 0))
                if onScreen and (Toggles.ESPNames.Value or Toggles.ESPDistance.Value) then
                    local parts = {}
                    if Toggles.ESPNames.Value then parts[#parts + 1] = ("%s [%s]"):format(plr.DisplayName, role) end
                    if Toggles.ESPDistance.Value and myRoot then
                        parts[#parts + 1] = ("%dm"):format(math.floor((root.Position - myRoot.Position).Magnitude + 0.5))
                    end
                    o.name.Text = table.concat(parts, "  ")
                    o.name.Color = col
                    o.name.Position = Vector2.new(sp.X, sp.Y)
                    o.name.Visible = true
                else
                    o.name.Visible = false
                end

                local rp, rootOnScreen = cam:WorldToViewportPoint(root.Position)
                if Toggles.ESPTracers.Value and rootOnScreen then
                    o.tracer.From = Vector2.new(vp.X / 2, vp.Y)
                    o.tracer.To = Vector2.new(rp.X, rp.Y)
                    o.tracer.Color = col
                    o.tracer.Visible = true
                else
                    o.tracer.Visible = false
                end
            end
        end
    end

    -- dropped gun
    local drop = Toggles.GunESP.Value and findGunDrop()
    if drop then
        gunHL.Adornee = drop
        gunHL.FillColor = Options.ColGun.Value
        gunHL.OutlineColor = Options.ColGun.Value
        gunHL.Enabled = true
        local sp, onScreen = cam:WorldToViewportPoint(drop.Position + Vector3.new(0, 1.5, 0))
        gunText.Position = Vector2.new(sp.X, sp.Y)
        gunText.Color = Options.ColGun.Value
        gunText.Visible = onScreen
    else
        gunHL.Enabled = false
        gunText.Visible = false
    end
end

bind(Players.PlayerRemoving, removeESP)

