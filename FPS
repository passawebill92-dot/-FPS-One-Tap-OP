-- ═══════════════════════════════════════════
-- SILENT AIM (WeaponService field swap)
-- ═══════════════════════════════════════════
local origGetMouseTargetCFrame = WeaponService.GetMouseTargetCFrame
local origGetTargetPosition = WeaponService.GetTargetPosition

local function predicted(root)
    return root.Position + root.AssemblyLinearVelocity * (Options.Prediction.Value / 1000)
end

local function closestToMouse()
    local cam = workspace.CurrentCamera
    local mouse = UIS:GetMouseLocation()
    local best, bestD
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local root = rootOf(plr)
            if root then
                local sp, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                    if not bestD or d < bestD then best, bestD = root, d end
                end
            end
        end
    end
    return best
end

local function silentAimPoint()
    if not (Toggles.SilentAim.Value or forceSilent) then return nil end
    if getRole(LP) == "Murderer" then
        local root = closestToMouse()
        return root and predicted(root)
    end
    local root = rootOf(findByRole("Murderer"))
    return root and predicted(root)
end

WeaponService.GetMouseTargetCFrame = function(self, ...)
    if Running then
        local p = silentAimPoint()
        if p then return CFrame.new(p) end
    end
    return origGetMouseTargetCFrame(self, ...)
end

WeaponService.GetTargetPosition = function(self, ...)
    if Running then
        local p = silentAimPoint()
        if p then return CFrame.new(p) end
    end
    return origGetTargetPosition(self, ...)
end

function shootMurderer()
    local gun = ownTool("Weapon_Gun")
    if not gun then
        Library:Notify({ Title = "MANA MM2", Description = "you don't have the gun", Time = 2 })
        return
    end
    if not rootOf(findByRole("Murderer")) then
        Library:Notify({ Title = "MANA MM2", Description = "murderer not found yet", Time = 2 })
        return
    end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if gun.Parent ~= LP.Character then
        hum:EquipTool(gun)
        task.wait(0.15)
    end
    forceSilent = true
    gun:Activate()
    task.delay(0.4, function() forceSilent = false end)
end

-- ═══════════════════════════════════════════
-- KNIFE AURA
-- ═══════════════════════════════════════════
local lastStab = 0
local function updateKillAura()
    if not Toggles.KillAura.Value then return end
    if not firetouchinterest then return end
    local knife = findTool(LP.Character, "Weapon_Knife")
    local handle = knife and knife:FindFirstChild("Handle")
    local myRoot = rootOf(LP)
    if not (handle and myRoot) then return end
    if os.clock() - lastStab < 0.25 then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local root = rootOf(plr)
            if root and (root.Position - myRoot.Position).Magnitude <= Options.AuraRange.Value then
                lastStab = os.clock()
                knife:Activate()
                firetouchinterest(handle, root, 0)
                firetouchinterest(handle, root, 1)
                return
            end
        end
    end
end

-- ═══════════════════════════════════════════
-- DROPPED GUN
-- ═══════════════════════════════════════════
local function findGunDrop()
    local d = workspace:FindFirstChild(GUN_DROP_NAME, true)
    return d and d:IsA("BasePart") and d or nil
end

local grabbing = false
function grabGun()
    if grabbing then return end
    local drop = findGunDrop()
    local myRoot = rootOf(LP)
    if not (drop and myRoot) then
        Library:Notify({ Title = "MANA MM2", Description = "no dropped gun right now", Time = 2 })
        return
    end
    if getRole(LP) == "Murderer" then return end
    grabbing = true
    local back = myRoot.CFrame
    myRoot.CFrame = drop.CFrame
    task.wait(0.3)
    if rootOf(LP) == myRoot then myRoot.CFrame = back end
    grabbing = false
end

task.spawn(function()
    while Running do
        if Toggles.AutoGrabGun.Value and not grabbing and findGunDrop()
            and getRole(LP) ~= "Murderer" and not ownTool("Weapon_Gun") and rootOf(LP) then
            grabGun()
        end
        task.wait(0.5)
    end
end)

