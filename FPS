local function aliveHumanoid(char)
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0 and h or nil
end

local function getTargets()
    local out = {}
    local me = LP.Character
    for _, char in ipairs(CollectionService:GetTagged("Character")) do
        if char ~= me and char.Parent and aliveHumanoid(char) and not char:FindFirstChildOfClass("ForceField") then
            out[#out + 1] = char
        end
    end
    return out
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function setRayIgnore(cam)
    local ignore = { cam }
    if LP.Character then ignore[#ignore + 1] = LP.Character end
    local fx = workspace:FindFirstChild("Effects")
    if fx then ignore[#ignore + 1] = fx end
    rayParams.FilterDescendantsInstances = ignore
end

local function isVisible(part, char, cam)
    setRayIgnore(cam)
    local origin = cam.CFrame.Position
    local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
    return hit == nil or hit.Instance:IsDescendantOf(char)
end

local function pickPart(char, mode, center, cam)
    if mode ~= "Closest" then return char:FindFirstChild(mode) end
    local best, bestD
    for _, name in ipairs({ "Head", "Torso" }) do
        local p = char:FindFirstChild(name)
        if p then
            local sp = cam:WorldToViewportPoint(p.Position)
            if sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if not bestD or d < bestD then best, bestD = p, d end
            end
        end
    end
    return best
end

local function getTarget(fov, mode, wallCheck)
    local cam = workspace.CurrentCamera
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local bestChar, bestPart, bestD = nil, nil, fov
    for _, char in ipairs(getTargets()) do
        local part = pickPart(char, mode, center, cam)
        if part then
            local sp = cam:WorldToViewportPoint(part.Position)
            if sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d <= bestD and (not wallCheck or isVisible(part, char, cam)) then
                    bestChar, bestPart, bestD = char, part, d
                end
            end
        end
    end
    return bestChar, bestPart
end

-- ═══════════════════════════════════════════
-- SHOT HOOK (useWeapon.send swap)
-- ═══════════════════════════════════════════
local function rewriteShot(pkt)
    if Toggles.SilentAim.Value and pkt.weaponType ~= "Knife" and math.random(1, 100) <= Options.HitChance.Value then
        local char, part = getTarget(Options.SilentFOV.Value, Options.SilentPart.Value, Toggles.SilentWallCheck.Value)
        if part then
            pkt.hitResult = char
            pkt.hitPart = part
            pkt.position = part.Position
            pkt.direction = (part.Position - pkt.origin).Unit
        end
    end
end

local function locateGameInternals()
    local fireImpl = getupvalue(WeaponClient.fire, 1)
    if type(fireImpl) ~= "function" then return false end
    for _, v in pairs(getupvalues(fireImpl)) do
        if type(v) == "table" then
            if type(rawget(v, "send")) == "function" and rawget(v, "reader") ~= nil then
                Hook.useWeapon = v
            elseif type(rawget(v, "Constants")) == "table" and type(rawget(v, "getWeaponData")) == "function" then
                Hook.WeaponManager = v
            end
        end
    end
    return Hook.useWeapon ~= nil and Hook.WeaponManager ~= nil
end

task.spawn(function()
    while Running and not locateGameInternals() do task.wait(0.5) end
    if not Running then return end

    Hook.origSend = Hook.useWeapon.send
    Hook.useWeapon.send = function(pkt)
        if Running then
            local ok, err = pcall(rewriteShot, pkt)
            if not ok then warn("[MANA FPS] shot rewrite: " .. tostring(err)) end
        end
        return Hook.origSend(pkt)
    end

    applyWeaponMods()
    hookStatus:SetText("shot hook: ready")
    Library:Notify({ Title = "MANA FPS", Description = "shot hook ready. silent aim + gun mods live.", Time = 3 })
end)

