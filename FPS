            local hum = aliveHumanoid(char)
            local root = char:FindFirstChild("HumanoidRootPart")

            -- chams
            if Toggles.Chams.Value and hum then
                local hl = Chams[char]
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = char
                    hl.Parent = chamsFolder
                    Chams[char] = hl
                end
                hl.FillColor = Options.ChamsFill.Value
                hl.OutlineColor = Options.ChamsOutline.Value
                hl.FillTransparency = Options.ChamsFillTrans.Value / 100
            elseif Chams[char] then
                Chams[char]:Destroy()
                Chams[char] = nil
            end

            -- drawings
            local o = ESP[char]
            local dist = (myRoot and root) and (root.Position - myRoot.Position).Magnitude or 0
            if not (Toggles.ESPEnabled.Value and hum and root and dist <= Options.ESPMaxDist.Value) then
                if o then hideESP(o) end
            else
                o = o or createESP()
                ESP[char] = o

                local top = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.6, 0))
                local bot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))

                if top.Z <= 0 or bot.Z <= 0 then
                    hideESP(o)
                else
                    local h = math.abs(bot.Y - top.Y)
                    local w = h * 0.6
                    local cx = (top.X + bot.X) / 2
                    local x1, x2, y1, y2 = cx - w / 2, cx + w / 2, top.Y, bot.Y

                    local head = char:FindFirstChild("Head")
                    local boxColor = Options.BoxColor.Value
                    if Toggles.ESPVisibleColor.Value and head and isVisible(head, char, cam) then
                        boxColor = Options.VisibleColor.Value
                    end

                    -- box
                    for _, l in ipairs(o.box) do l.Visible = false end
                    if Toggles.ESPBox.Value then
                        if Options.BoxStyle.Value == "Full" then
                            line(o.box[1], Vector2.new(x1, y1), Vector2.new(x2, y1), boxColor)
                            line(o.box[2], Vector2.new(x1, y2), Vector2.new(x2, y2), boxColor)
                            line(o.box[3], Vector2.new(x1, y1), Vector2.new(x1, y2), boxColor)
                            line(o.box[4], Vector2.new(x2, y1), Vector2.new(x2, y2), boxColor)
                        else
                            local cw, ch = w * 0.25, h * 0.2
                            line(o.box[1], Vector2.new(x1, y1), Vector2.new(x1 + cw, y1), boxColor)
                            line(o.box[2], Vector2.new(x1, y1), Vector2.new(x1, y1 + ch), boxColor)
                            line(o.box[3], Vector2.new(x2, y1), Vector2.new(x2 - cw, y1), boxColor)
                            line(o.box[4], Vector2.new(x2, y1), Vector2.new(x2, y1 + ch), boxColor)
                            line(o.box[5], Vector2.new(x1, y2), Vector2.new(x1 + cw, y2), boxColor)
                            line(o.box[6], Vector2.new(x1, y2), Vector2.new(x1, y2 - ch), boxColor)
                            line(o.box[7], Vector2.new(x2, y2), Vector2.new(x2 - cw, y2), boxColor)
                            line(o.box[8], Vector2.new(x2, y2), Vector2.new(x2, y2 - ch), boxColor)
                        end
                    end

                    -- name
                    if Toggles.ESPName.Value then
                        local plr = Players:GetPlayerFromCharacter(char)
                        o.name.Text = plr and plr.DisplayName or char.Name
                        o.name.Position = Vector2.new(cx, y1 - 16)
                        o.name.Visible = true
                    else
                        o.name.Visible = false
                    end

                    -- info line under the box
                    local parts = {}
                    if Toggles.ESPDistance.Value then parts[#parts + 1] = string.format("%dm", math.floor(dist + 0.5)) end
                    if Toggles.ESPWeapon.Value then parts[#parts + 1] = heldWeaponName(char) end
                    if char:FindFirstChildOfClass("ForceField") then parts[#parts + 1] = "[SPAWN]" end
                    if #parts > 0 then
                        o.info.Text = table.concat(parts, "  ")
                        o.info.Position = Vector2.new(cx, y2 + 2)
                        o.info.Visible = true
                    else
                        o.info.Visible = false
                    end

                    -- health
                    if Toggles.ESPHealth.Value then
                        local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        o.hpBack.From = Vector2.new(x1 - 5, y2 + 1)
                        o.hpBack.To = Vector2.new(x1 - 5, y1 - 1)
                        o.hpBack.Visible = true
                        line(o.hpFill, Vector2.new(x1 - 5, y2), Vector2.new(x1 - 5, y2 - h * ratio), Color3.fromHSV(ratio * 0.33, 0.85, 1))
                    else
                        o.hpBack.Visible = false
                        o.hpFill.Visible = false
                    end

                    -- tracer
                    if Toggles.ESPTracer.Value then
                        local from
                        local origin = Options.TracerOrigin.Value
                        if origin == "Bottom" then
                            from = Vector2.new(vp.X / 2, vp.Y)
                        elseif origin == "Center" then
                            from = Vector2.new(vp.X / 2, vp.Y / 2)
                        else
                            from = UIS:GetMouseLocation()
                        end
                        line(o.tracer, from, Vector2.new(cx, y2), Options.TracerColor.Value)
                    else
                        o.tracer.Visible = false
                    end

                    -- skeleton (R6)
                    for _, l in ipairs(o.skel) do l.Visible = false end
                    if Toggles.ESPSkeleton.Value then
                        local torso = char:FindFirstChild("Torso")
                        if head and torso then
                            local col = Options.SkeletonColor.Value
                            local function sp(v3)
                                local p = cam:WorldToViewportPoint(v3)
                                return Vector2.new(p.X, p.Y)
                            end
                            local neck = sp((torso.CFrame * CFrame.new(0, 1, 0)).Position)
                            local pelvis = sp((torso.CFrame * CFrame.new(0, -1, 0)).Position)
                            line(o.skel[1], sp(head.Position), neck, col)
                            line(o.skel[2], neck, pelvis, col)
                            local limbs = {
                                { 3, "Left Arm", neck }, { 4, "Right Arm", neck },
                                { 5, "Left Leg", pelvis }, { 6, "Right Leg", pelvis },
                            }
                            for _, lb in ipairs(limbs) do
                                local limb = char:FindFirstChild(lb[2])
                                if limb then
                                    line(o.skel[lb[1]], lb[3], sp((limb.CFrame * CFrame.new(0, -1, 0)).Position), col)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for char, o in pairs(ESP) do
        if not seen[char] then
            removeESP(o)
            ESP[char] = nil
        end
    end
    for char, hl in pairs(Chams) do
        if not seen[char] then
            hl:Destroy()
            Chams[char] = nil
        end
    end
end

-- ═══════════════════════════════════════════
-- COMBAT LOOP PIECES
-- ═══════════════════════════════════════════
local function updateFOVCircles(cam)
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    silentCircle.Visible = Toggles.ShowSilentFOV.Value
    silentCircle.Position = center
    silentCircle.Radius = Options.SilentFOV.Value
    silentCircle.Color = Options.SilentFOVColor.Value

    aimCircle.Visible = Toggles.ShowAimFOV.Value
    aimCircle.Position = center
    aimCircle.Radius = Options.AimFOV.Value
    aimCircle.Color = Options.AimFOVColor.Value
end

local function updateAimbot(cam)
    if not (Toggles.Aimbot.Value and Options.AimKey:GetState()) then return end
    local _, part = getTarget(Options.AimFOV.Value, Options.AimPart.Value, Toggles.AimWallCheck.Value)
    if not part then return end

    local aimPos = part.Position
    if Toggles.AimPrediction.Value then
        local speed = Hook.WeaponManager and Hook.WeaponManager.Constants.DEFAULT_SPEED or 3850
        local travel = (aimPos - cam.CFrame.Position).Magnitude / speed
        aimPos += part.AssemblyLinearVelocity * travel
    end
    cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, aimPos), 1 / Options.AimSmooth.Value)
end

local triggerPending = false
local function updateTriggerbot(cam)
    if not Toggles.Triggerbot.Value or triggerPending then return end
    setRayIgnore(cam)
    local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 1500, rayParams)
    if not hit then return end
    local model = hit.Instance:FindFirstAncestorWhichIsA("Model")
    if model and model ~= LP.Character and CollectionService:HasTag(model, "Character")
        and aliveHumanoid(model) and not model:FindFirstChildOfClass("ForceField") then
        triggerPending = true
        task.delay(Options.TriggerDelay.Value / 1000, function()
            if Running then WeaponClient.fire() end
            triggerPending = false
        end)
    end
end

local function updateAutoShoot()
    if not (Toggles.AutoShoot.Value and Toggles.SilentAim.Value) then return end
    if WeaponClient.getState() ~= "free" then return end
    -- always wall-checked: shooting through walls is exactly what gets a packet rejected
    local _, part = getTarget(Options.SilentFOV.Value, Options.SilentPart.Value, true)
    if part then WeaponClient.fire() end
end

-- ═══════════════════════════════════════════
-- WORLD
-- ═══════════════════════════════════════════
local lightingSaved
local function updateFullbright()
    if Toggles.Fullbright.Value then
        if not lightingSaved then
            lightingSaved = {
                Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
                FogEnd = Lighting.FogEnd, GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient,
            }
        end
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1e5
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    elseif lightingSaved then
        for k, v in pairs(lightingSaved) do Lighting[k] = v end
        lightingSaved = nil
    end
end

local fovApplied = false
local function updateFOV(cam)
    if Toggles.FOVChanger.Value then
        if not WeaponClient.isScoping() then
            cam.FieldOfView = Options.FOVValue.Value
            fovApplied = true
        end
    elseif fovApplied then
        cam.FieldOfView = GAME_DEFAULT_FOV
        fovApplied = false
    end
end

-- ═══════════════════════════════════════════
-- MOVEMENT (NewChecker-safe)
-- ═══════════════════════════════════════════
local flyPos = nil

local function markAirborne(char)
    -- NewChecker skips the airtime check while lastJumpBoost is < 3s old
    char:SetAttribute("lastJumpBoost", workspace:GetServerTimeNow())
end

local function updateMovement(dt)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0) then
        flyPos = nil
        return
    end
    local cam = workspace.CurrentCamera

    -- fly: CFrame-tracked, zero velocity, yaw-only rotation
    if Toggles.Fly.Value then
        flyPos = flyPos or root.Position
        local dir = Vector3.zero
        if not UIS:GetFocusedTextBox() then
            local cf = cam.CFrame
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
        end
        if dir.Magnitude > 0 then dir = dir.Unit end
        flyPos += dir * Options.FlySpeed.Value * dt

        local look = cam.CFrame.LookVector
        local yaw = math.atan2(-look.X, -look.Z)
        root.CFrame = CFrame.new(flyPos) * CFrame.Angles(0, yaw, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        markAirborne(char)
        return
    end
    flyPos = nil

    -- speed: CFrame nudge, horizontal velocity stays under NewChecker's 50 cap
    if Toggles.Speed.Value and hum.MoveDirection.Magnitude > 0 then
        local extra = math.max(Options.SpeedValue.Value - hum.WalkSpeed, 0)
        root.CFrame += hum.MoveDirection * extra * dt
    end

    -- bhop
    if Toggles.Bhop.Value and not UIS:GetFocusedTextBox() and UIS:IsKeyDown(Enum.KeyCode.Space)
        and hum.FloorMaterial ~= Enum.Material.Air then
        hum.Jump = true
    end

    if hum.FloorMaterial == Enum.Material.Air and (Toggles.InfJump.Value or Toggles.Speed.Value) then
        markAirborne(char)
    end
end

bind(UIS.JumpRequest, function()
    if not (Running and Toggles.InfJump.Value) then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0) then return end
    if hum.FloorMaterial == Enum.Material.Air then
        -- straight velocity write, no Jumping state -> NewChecker's Jumping handler never fires
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_VELOCITY, v.Z)
        markAirborne(char)
    end
end)

bind(RunService.Stepped, function()
    if not (Running and Toggles.Noclip.Value) then return end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end)

-- ═══════════════════════════════════════════
-- AUTOMATION
-- ═══════════════════════════════════════════
-- auto respawn: watcher, not a one-shot Died handler.
--   * remembers the character was deployed while alive (the attribute can clear on death)
--   * works even if the toggle is flipped on after you already died
--   * retries every 1.5s until the server gives you a new character
-- respawn(true) on a dead deployed character is exactly what the game's own Leave screen sends.
-- lobby deaths (never deployed) are already auto-respawned by the game after 3s.
task.spawn(function()
    local deployedChar = nil
    local lastAttempt = 0
    while Running do
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health > 0 then
                if char:GetAttribute("deployed") then deployedChar = char end
            elseif Toggles.AutoRespawn.Value and (deployedChar == char or char:GetAttribute("deployed")) then
                if os.clock() - lastAttempt >= 1.5 then
                    lastAttempt = os.clock()
                    DeathScreen._requestRespawn(true)
                end
            end
        end
        task.wait(0.25)
    end
end)

task.spawn(function()
    while Running do
        if Toggles.AutoDeploy.Value and workspace:GetAttribute("gameState") == "game" then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not char:GetAttribute("deployed") then
                DeployClient.deploy()
            end
        end
        task.wait(1)
    end
end)

bind(LP.Idled, function()
    if Running and Toggles.AntiAFK.Value then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.zero)
    end
end)

