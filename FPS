Library:OnUnload(function()
    Running = false
    for _, c in ipairs(Conns) do c:Disconnect() end

    if Hook.useWeapon and Hook.origSend then
        Hook.useWeapon.send = Hook.origSend
    end
    restoreAllFields()

    for _, o in pairs(ESP) do removeESP(o) end
    table.clear(ESP)
    silentCircle:Remove()
    aimCircle:Remove()
    chamsFolder:Destroy()

    if lightingSaved then
        for k, v in pairs(lightingSaved) do Lighting[k] = v end
    end
    if fovApplied and workspace.CurrentCamera then
        workspace.CurrentCamera.FieldOfView = GAME_DEFAULT_FOV
    end
    G.__rs_onetap_unload = nil
end)

G.__rs_onetap_unload = function() Library:Unload() end

